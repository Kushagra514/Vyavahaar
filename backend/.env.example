# Vyavahaar Backend Environment Variables
PROJECT_NAME="Vyavahaar API"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database (Default: local SQLite; for production PostgreSQL: postgresql://user:pass@localhost:5432/vyavahaar)
DATABASE_URL="sqlite:///./vyavahaar.db"

# Development & Sandbox Testing
DEV_MODE=True
DEV_TEST_PHONE="+919876543210"
DEV_TEST_OTP="123456"

# Optional Cloud Integrations
GEMINI_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CREDENTIALS_JSON=""
